{
  "manifest_version": 3,
  "name": "Dola Multi-Tab — Soori Academy",
  "version": "1.0.0",
  "description": "Open up to 20 copies of your Dola chat tab and auto-set each one to Pro + your chosen Skill.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://www.dola.com/*",
    "https://dola.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dola.com/*", "https://dola.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Dola Multi-Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
